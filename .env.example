# NHS Digital Hospital Agent - example environment
#
# Copy to .env and fill in local values:  cp .env.example .env
# NEVER commit .env. It is listed in .gitignore.
#
# There are no working default secrets in this file by design. A blank JWT_SECRET
# stops the API at startup rather than letting it run with a predictable key.

# --- Application -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# Host `db` matches the service name in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://hospital:CHANGE_ME@db:5432/hospital
POSTGRES_USER=hospital
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hospital

# Host port for the database container. Defaults to 5433 because a native PostgreSQL
# install commonly occupies 5432 and would shadow the container.
POSTGRES_HOST_PORT=5433
DB_ECHO=false

# --- Authentication ----------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30
MAX_FAILED_LOGINS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- CORS --------------------------------------------------------------------
# Comma-separated. The app reaches the API through its own origin (next.config.ts proxies
# /api/v1), so a browser using the app never makes a cross-origin call and this list is not
# on that path. It matters only if a page on another origin calls the API directly.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Integration ports -------------------------------------------------------
# See docs/architecture/02-system-architecture.md
FHIR_MODE=local
FHIR_BASE_URL=
TRIAGE_ENGINE=rules
NOTIFICATION_SINK=console
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Rate limiting -----------------------------------------------------------
# Shared counters for the rate limiter. docker-compose.yml sets this for the api container.
# Outside Docker, leave it blank for the in-process limiter - fine for one development
# process. Production refuses to start without it.
REDIS_URL=

# --- Frontend ----------------------------------------------------------------
# The frontend has its own environment file: frontend/.env.example. It needs no API URL,
# because the browser reaches the API through the app's own origin.

# --- Demo seeding ------------------------------------------------------------
# Used only by scripts/seed_demo.py, and only for @example.test accounts.
# Leave blank in any environment that is not a local demo.
# The sign-in page lists demo-hospital-2026; use that value unless you change the page too.
DEMO_PASSWORD=
