# Frontend environment. Copy to .env.local:  cp .env.example .env.local
#
# The browser never addresses the API directly: /api/v1 on this app's own origin is
# proxied to the backend by next.config.ts. That keeps the session cookie first-party and
# the backend's address out of the browser - so there is deliberately no public API URL.

# Server-side only: where the Next server proxies /api/v1 to. Never exposed to the browser.
# For a production image this is a build argument - see docker/Dockerfile.frontend.
API_ORIGIN=http://localhost:8000
